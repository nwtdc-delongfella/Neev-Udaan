# Copy to functions/.env.<your-project-id> (deploy) or functions/.env.local (emulator).
# These are public app IDs, not secrets. Secrets are set with `firebase functions:secrets:set`.
META_APP_ID=
INSTAGRAM_APP_ID=
GOOGLE_CLIENT_ID=
META_GRAPH_VERSION=v24.0
# Optional: Facebook Login for Business configuration ID (replaces the permission list)
META_LOGIN_CONFIG_ID=
# Leave empty to use https://asia-south1-<project>.cloudfunctions.net/oauthCallback
OAUTH_REDIRECT_URI=
